# Required for Telegram polling
BOT_TOKEN=replace_with_telegram_bot_token

# Optional runtime settings
SLP_REFRESH_INTERVAL_SECONDS=240
SLP_DB_PATH=./slp.db
SLP_LOG_LEVEL=INFO
# Telegram IDs allowed to use /refresh and /errors. Empty = nobody.
ADMIN_IDS=

# Optional: only used by explicit independent web verification
OPENSERP_BIN=

# Remote OpenSERP service (preferred in Railway)
OPENSERP_BASE_URL=

# Optional OpenRouter integration. Keep the real key in deployment secrets only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=~openai/gpt-latest
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=SLP
